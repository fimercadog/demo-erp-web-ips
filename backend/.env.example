APP_NAME=VetPanel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Zona horaria de la clínica: la agenda y las fechas clínicas se calculan acá.
APP_TIMEZONE=America/Bogota
FRONTEND_URL=http://localhost:3000
# Dominios extra permitidos por CORS, separados por coma (ademas de FRONTEND_URL).
# Ej: CORS_EXTRA_ORIGINS=https://demo.tu-dominio.com,https://app.tu-dominio.com
CORS_EXTRA_ORIGINS=

# APP_LOCALE se deja en 'en': no hay carpeta lang/ propia y los FormRequest
# del API ya traen sus mensajes en español (ver App\Http\Requests\ApiFormRequest).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Auth por cookie httpOnly (Sanctum SPA), no bearer token. En local, frontend
# y backend comparten origen via el rewrite de Next (localhost:3000) y esto
# funciona tal cual. En produccion, si el frontend vive en OTRO dominio que el
# backend (cookie cross-site), agregar ademas:
# SESSION_SAME_SITE=none
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=tu-dominio-frontend.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Integración Google Calendar (OAuth2 2-Way Sync)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google-calendar/callback
